<?xml version="1.0" encoding="utf-8"?>
<!--
  Vatandaş (belediyem.gov.tr) ve panel (panel.belediyem.gov.tr) SPA siteleri için
  IIS web.config. Gerektirir: "URL Rewrite" modülü (+ /api reverse-proxy kullanacaksanız
  "Application Request Routing / ARR").

  İki topolojiden birini seçin:
   A) Reverse-proxy (önerilen, frontend kodu değişmez): SPA sitesi /api'yi API domainine
      proxy'ler. Aşağıdaki "api-proxy" kuralını AÇIK bırakın, ARR'ı etkinleştirin.
   B) Doğrudan CORS: SPA, API domainini MUTLAK URL ile çağırır. Bu projede SPA'lar /api'yi
      GÖRELİ çağırdığından B seçeneği için fetch katmanına bir API taban URL'i eklenmelidir
      (küçük bir kod değişikliği). Önerilen yol A'dır.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- A) API reverse-proxy (ARR gerektirir). API domainini kendinize göre değiştirin. -->
        <rule name="api-proxy" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="https://api.belediyem.gov.tr/api/{R:1}" />
        </rule>

        <!-- SPA client-side routing: dosya/dizin değilse index.html'e düş. -->
        <rule name="spa-fallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>
    <staticContent>
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
    </staticContent>
  </system.webServer>
</configuration>
