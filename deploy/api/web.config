<?xml version="1.0" encoding="utf-8"?>
<!--
  API (CitizenPlatform.Api) için IIS web.config şablonu.
  IIS'e "ASP.NET Core Hosting Bundle" kurulu olmalı (ANCM v2).
  Gizli değerleri (JWT secret, DB, MinIO) sunucuda BURADA doldurun ya da
  App Pool / makine düzeyinde ortam değişkeni olarak verin. Bu dosyayı repoya
  GERÇEK secret ile göndermeyin.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet"
                  arguments=".\CitizenPlatform.Api.dll"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
          <!-- Aşağıdakileri gerçek değerlerle doldurun: -->
          <environmentVariable name="JWT__SECRET" value="__DEGISTIRIN_EN_AZ_32_KARAKTER_RASTGELE__" />
          <environmentVariable name="Database__ConnectionString" value="Host=DB_HOST;Port=5432;Database=citizen_platform;Username=citizen_platform;Password=__PAROLA__" />
          <environmentVariable name="CORS__ALLOWED_ORIGINS" value="https://belediyem.gov.tr,https://panel.belediyem.gov.tr" />
          <!-- Fotoğraflar için MinIO/S3 (opsiyonel): -->
          <environmentVariable name="ObjectStorage__Provider" value="Minio" />
          <environmentVariable name="ObjectStorage__Endpoint" value="https://minio.belediyem.gov.tr" />
          <environmentVariable name="ObjectStorage__BucketName" value="citizen-platform" />
          <environmentVariable name="ObjectStorage__AccessKey" value="__ACCESS__" />
          <environmentVariable name="ObjectStorage__SecretKey" value="__SECRET__" />
          <environmentVariable name="ObjectStorage__UseSsl" value="true" />
          <!-- Gerçek SMS (opsiyonel): -->
          <environmentVariable name="SMS__PROVIDER" value="Netgsm" />
          <environmentVariable name="SMS__NETGSM__USERCODE" value="__USERCODE__" />
          <environmentVariable name="SMS__NETGSM__PASSWORD" value="__PASSWORD__" />
          <environmentVariable name="SMS__NETGSM__MSGHEADER" value="__BASLIK__" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
