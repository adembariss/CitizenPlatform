ASPNETCORE_ENVIRONMENT=Development

MAIN_DB_NAME=citizen_platform
MAIN_DB_USER=citizen_platform
MAIN_DB_PASSWORD=change-me-local
MAIN_DB_PORT=5432
MAIN_DB_CONNECTION=Host=localhost;Port=5432;Database=citizen_platform;Username=citizen_platform;Password=change-me-local
MAIN_DB_CONNECTION_STRING=Host=localhost;Port=5432;Database=citizen_platform;Username=citizen_platform;Password=change-me-local

MUNICIPALITY_DB_NAME=municipality_sample
MUNICIPALITY_DB_USER=municipality_sample
MUNICIPALITY_DB_PASSWORD=change-me-local
MUNICIPALITY_DB_PORT=5433
SAMPLE_MUNICIPALITY_DB_CONNECTION=Host=localhost;Port=5433;Database=municipality_sample;Username=municipality_sample;Password=change-me-local
MUNICIPALITY_DB_CONNECTION_STRING=Host=localhost;Port=5433;Database=municipality_sample;Username=municipality_sample;Password=change-me-local

MINIO_ROOT_USER=citizenplatform
MINIO_ROOT_PASSWORD=change-me-local
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# .NET config binding icin dogru isimler (ObjectStorage section'ina bind edilir).
# Provider=Minio yapip endpoint/bucket/credential'lari doldurunca MinIO'ya gecer.
ObjectStorage__Provider=Local
ObjectStorage__Endpoint=http://localhost:9000
ObjectStorage__BucketName=citizen-platform-local
ObjectStorage__AccessKey=citizenplatform
ObjectStorage__SecretKey=change-me-local
ObjectStorage__UseSsl=false
ObjectStorage__LocalRootPath=storage/complaint-attachments
ObjectStorage__MaxFileSizeBytes=10485760
ObjectStorage__MaxRequestBodySizeBytes=52428800

JWT__ISSUER=citizen-platform
JWT__AUDIENCE=citizen-platform
# Development disinda default secret ile acilis reddedilir (min 32 karakter zorunlu).
JWT__SECRET=change-me-local-development-secret-please-replace
JWT__ACCESS_TOKEN_MINUTES=60
JWT__REFRESH_TOKEN_DAYS=14

CORS__ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4173

# SMS: varsayılan "Log" (geliştirme, kodu ifşa eder). Gerçek gönderim için Provider=Netgsm
# yapıp Netgsm bilgilerini doldurun (kod prod'da ifşa edilmez).
SMS__PROVIDER=Log
SMS__NETGSM__USERCODE=
SMS__NETGSM__PASSWORD=
SMS__NETGSM__MSGHEADER=
